# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000
NODE_ENV=development

# Local MongoDB (default). For MongoDB Atlas, paste your own connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/farmbridge

# Address of the React app, allowed to call this API (CORS).
CLIENT_ORIGIN=http://localhost:5173
